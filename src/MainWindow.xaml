<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="译知 · DeepSeek 桌面翻译" Width="1280" Height="840" MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Workspace}" Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Workspace" Color="#F4F7F8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSoft" Color="#F8FAFA"/>
    <SolidColorBrush x:Key="Stroke" Color="#D8E2E5"/>
    <SolidColorBrush x:Key="Divider" Color="#E7EDEF"/>
    <SolidColorBrush x:Key="Ink" Color="#213C42"/>
    <SolidColorBrush x:Key="Secondary" Color="#536D73"/>
    <SolidColorBrush x:Key="MutedInk" Color="#5D7379"/>
    <SolidColorBrush x:Key="Accent" Color="#16796D"/>
    <SolidColorBrush x:Key="AccentHover" Color="#12685E"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#0E574F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E7F2EE"/>
    <SolidColorBrush x:Key="Focus" Color="#298E7B"/>
    <SolidColorBrush x:Key="Danger" Color="#A53E32"/>
    <SolidColorBrush x:Key="Warning" Color="#80602D"/>
    <SolidColorBrush x:Key="NavBackground" Color="#173237"/>
    <SolidColorBrush x:Key="NavHover" Color="#214248"/>
    <SolidColorBrush x:Key="NavSelected" Color="#2A4B50"/>
    <SolidColorBrush x:Key="NavInk" Color="#C1D6D7"/>
    <SolidColorBrush x:Key="NavMuted" Color="#A0BDBF"/>
    <SolidColorBrush x:Key="NavActiveInk" Color="#CBF0E4"/>

    <Geometry x:Key="IconText">M 3,4 L 17,4 M 10,4 L 10,17 M 6,17 L 14,17</Geometry>
    <Geometry x:Key="IconDocument">M 5,2 L 12,2 L 17,7 L 17,18 L 3,18 L 3,2 Z M 12,2 L 12,7 L 17,7 M 6,11 L 14,11 M 6,14 L 12,14</Geometry>
    <Geometry x:Key="IconBook">M 10,5 C 7,2 3,3 2,4 L 2,17 C 5,15 8,15 10,18 C 12,15 15,15 18,17 L 18,4 C 15,2 12,3 10,5 L 10,18</Geometry>
    <Geometry x:Key="IconHistory">M 3,8 C 5,1 16,1 18,9 C 20,18 7,22 3,15 M 3,3 L 3,8 L 8,8 M 10,6 L 10,11 L 13,13</Geometry>
    <Geometry x:Key="IconSettings">M 2,5 L 18,5 M 2,10 L 18,10 M 2,15 L 18,15 M 6,2 L 6,8 M 14,7 L 14,13 M 8,12 L 8,18</Geometry>
    <Geometry x:Key="IconCopy">M 7,6 L 17,6 L 17,18 L 7,18 Z M 13,6 L 13,2 L 3,2 L 3,14 L 7,14</Geometry>
    <Geometry x:Key="IconKey">M 13,12 C 7,14 4,8 7,4 C 12,-1 19,5 15,10 L 9,16 L 6,16 L 6,19 L 2,19 L 2,15 L 7,10</Geometry>
    <Geometry x:Key="IconSwap">M 2,6 L 18,6 M 14,2 L 18,6 L 14,10 M 18,14 L 2,14 M 6,10 L 2,14 L 6,18</Geometry>
    <Geometry x:Key="IconTranslation">M 2,4 L 12,4 M 7,2 L 7,4 M 4,4 C 4,10 8,12 12,13 M 10,4 C 10,10 6,13 2,14 M 11,18 L 15,9 L 19,18 M 12,15 L 18,15</Geometry>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path x:Name="ActionIcon" Data="{TemplateBinding Tag}" Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border x:Name="FocusRing" CornerRadius="9" BorderBrush="{StaticResource Focus}" BorderThickness="2" Margin="-3" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceSoft}"/><Setter Property="BorderBrush" Value="#A7BDBF"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DFEAE6"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#EFF3F3"/><Setter Property="Foreground" Value="#61767B"/><Setter Property="BorderBrush" Value="#DCE4E5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource AccentPressed}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#DFE9E5"/><Setter Property="Foreground" Value="#49655D"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource NavInk}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="15,0"/><Setter Property="Height" Value="44"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource NavHover}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ApiBadgeStyle" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Tag" Value="{StaticResource IconKey}"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="NavActive" TargetType="Button" BasedOn="{StaticResource Nav}">
      <Setter Property="Background" Value="{StaticResource NavSelected}"/><Setter Property="Foreground" Value="{StaticResource NavActiveInk}"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#31575C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#284E54"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="11,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#9AD7C4"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Background" Value="#EFF3F3"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Editor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="16"/><Setter Property="TextBlock.LineHeight" Value="26"/><Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,16"/><Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="PasswordBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="12"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Secondary}" StrokeThickness="1.4" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" StrokeLineJoin="Round"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="SelectedContent" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,6,32,6" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="10,6,32,6" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="330" Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0">
              <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#A7BDBF"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Focus}"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Background" Value="#EFF3F3"/><Setter Property="Foreground" Value="#61767B"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="11,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EFF5F2"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="7,3,0,3"/></Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource SurfaceSoft}"/><Setter Property="Foreground" Value="{StaticResource Secondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border x:Name="CellBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Focus}" BorderThickness="0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CellBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="HistoryRow" Background="Transparent" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryRow" Property="Background" Value="{StaticResource SurfaceSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryRow" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="HistoryRow" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedInk}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style x:Key="EditorCard" TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger></Style.Triggers></Style>
  </Window.Resources>

  <Grid Background="{StaticResource Workspace}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource NavBackground}">
      <Grid Margin="14,28,14,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,32">
          <Border Width="38" Height="38" Background="#9EDDC9" CornerRadius="10"><TextBlock Text="译" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavBackground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="11,0,0,0"><TextBlock Text="译知" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="MY TRANSLATOR" FontSize="9" Foreground="{StaticResource NavMuted}" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="TranslateNav" Style="{StaticResource Nav}" Tag="{StaticResource IconText}" Content="文本翻译"/>
          <Button x:Name="DocumentNav" Style="{StaticResource Nav}" Tag="{StaticResource IconDocument}" Content="文档翻译"/>
          <Button x:Name="GlossaryNav" Style="{StaticResource Nav}" Tag="{StaticResource IconBook}" Content="专业术语"/>
          <Button x:Name="HistoryNav" Style="{StaticResource Nav}" Tag="{StaticResource IconHistory}" Content="翻译历史"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border BorderBrush="#36575C" BorderThickness="0,1,0,0" Padding="12,18,8,18" Margin="0,0,0,8">
            <StackPanel><TextBlock Text="为专业表达而设计" Foreground="#C8E4DB" FontSize="12"/><TextBlock Text="论文 · 技术 · 日常文本" Foreground="{StaticResource NavMuted}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
          </Border>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Tag="{StaticResource IconSettings}" Content="API 设置"/>
          <TextBlock Text="v1.1.1  /  Powered by DeepSeek" Foreground="{StaticResource NavMuted}" FontSize="9" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0">
          <TextBlock x:Name="Breadcrumb" Visibility="Collapsed"/>
          <TextBlock x:Name="PageTitle" Text="文本翻译" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="自动识别语种，让每一个专业表达准确传达。" Foreground="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21"/>
        </StackPanel>
        <Button x:Name="ApiBadge" Grid.Column="1" Content="待配置 API" Style="{StaticResource ApiBadgeStyle}" VerticalAlignment="Top"/>
      </Grid>

      <Grid x:Name="TranslatePage" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="DocumentPanel" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,16" Visibility="Collapsed" AllowDrop="True">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Path Data="{StaticResource IconDocument}" Width="26" Height="30" Stretch="Uniform" Stroke="{StaticResource Secondary}" StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock x:Name="DocumentFileName" Text="选择或拖入一份文档" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DocumentSummary" Text="PDF · Word (.docx) · Markdown · TXT" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
              <Button x:Name="SelectDocumentButton" Grid.Column="2" Content="选择文档" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="DocumentWarning" Text="先在本地提取文字，预览确认后点击翻译。扫描 PDF 请先 OCR；不还原原文档版式。" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="196"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="专业领域" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Secondary}"/>
            <ComboBox x:Name="DomainBox" Grid.Column="1" AutomationProperties.Name="专业领域"/>
            <TextBlock Text="翻译风格" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Secondary}"/>
            <ComboBox x:Name="StyleBox" Grid.Column="4" AutomationProperties.Name="翻译风格"/>
            <Button x:Name="TermsHint" Grid.Column="5" Content="管理术语" Style="{StaticResource Quiet}" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource EditorCard}"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="14,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="原文" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="SourceBox" Grid.Column="1" Width="134" AutomationProperties.Name="源语言"/>
                <TextBlock x:Name="DetectedText" Grid.Column="2" Text="翻译时识别" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </Grid>
            </Border>
            <Grid Grid.Row="1">
              <TextBox x:Name="SourceText" Style="{StaticResource Editor}" AcceptsTab="True" MaxLength="100000" AutomationProperties.Name="原文编辑区"/>
              <TextBlock x:Name="SourcePlaceholder" Text="输入或粘贴需要翻译的文本…&#10;&#10;支持论文段落、技术文档和日常表达。" FontSize="16" Foreground="{StaticResource MutedInk}" Margin="20,18" IsHitTestVisible="False" TextWrapping="Wrap" LineHeight="26"/>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="12,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="PasteButton" Content="粘贴" Padding="10,7"/><Button x:Name="ImportButton" Content="导入文档" Tag="{StaticResource IconDocument}" Padding="10,7" Margin="8,0,0,0"/><Button x:Name="ClearButton" Content="清空" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="10,7"/></StackPanel><TextBlock x:Name="SourceCount" Grid.Column="2" Text="0 字符" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
            </Border>
          </Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource EditorCard}"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="14,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="译文" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="TargetBox" Grid.Column="1" Width="134" AutomationProperties.Name="目标语言"/>
                <TextBlock x:Name="OutputState" Grid.Column="2" Text="待翻译" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0"/>
                <Button x:Name="SwapButton" Grid.Column="3" Content="交换" Tag="{StaticResource IconSwap}" Style="{StaticResource Quiet}" Padding="8,7" ToolTip="将译文放回原文，并交换语言"/>
              </Grid>
            </Border>
            <Grid Grid.Row="1">
              <TextBox x:Name="OutputText" Style="{StaticResource Editor}" IsReadOnly="True" AutomationProperties.Name="译文阅读区"/>
              <StackPanel x:Name="OutputPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="16">
                <Path Data="{StaticResource IconTranslation}" Width="32" Height="32" Stretch="Uniform" Stroke="{StaticResource MutedInk}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"/>
                <TextBlock Text="译文将在这里呈现" Foreground="{StaticResource Secondary}" FontSize="16" Margin="0,18,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="保留原意，也照顾专业语境" Foreground="{StaticResource MutedInk}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="12,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="CopyButton" Content="复制译文" Tag="{StaticResource IconCopy}" Padding="10,7"/><Button x:Name="ExportButton" Content="导出" Padding="10,7" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="OutputCount" Grid.Column="2" Text="0 字符" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
            </Border>
          </Grid></Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><StackPanel x:Name="TextExamples" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="试一试" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ExampleButton" Content="电子工程示例" Style="{StaticResource Quiet}"/></StackPanel>
            <TextBlock x:Name="DocumentTip" Text="本地提取 · 预览原文 · 选择目标语言后翻译" Style="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="停止翻译" Visibility="Collapsed" Margin="0,0,12,0"/><Button x:Name="TranslateButton" Style="{StaticResource Primary}" Content="开始翻译" Width="160" Height="44" ToolTip="Ctrl + Enter"/></StackPanel>
          </Grid>
          <ProgressBar x:Name="TaskProgress" Grid.Row="1" Height="3" Margin="0,12,0,0" Foreground="{StaticResource Accent}" Background="#DCE6E3" Visibility="Collapsed" AutomationProperties.Name="翻译或文档提取进度"/>
        </Grid>
      </Grid>

      <Grid x:Name="GlossaryPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="让术语保持一致" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="指定术语的译法。只有匹配原文、目标语言和领域的条目才会随翻译发送。" Foreground="{StaticResource Secondary}" Margin="0,8,0,18" TextWrapping="Wrap" LineHeight="21"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><Label Content="原文术语" Target="{Binding ElementName=TermSource}" Foreground="{StaticResource Secondary}" Padding="0,0,0,8"/><TextBox x:Name="TermSource" MaxLength="200" AutomationProperties.Name="原文术语"/></StackPanel>
            <StackPanel Grid.Column="2"><Label Content="指定译法" Target="{Binding ElementName=TermTarget}" Foreground="{StaticResource Secondary}" Padding="0,0,0,8"/><TextBox x:Name="TermTarget" MaxLength="200" AutomationProperties.Name="指定译法"/></StackPanel>
          </Grid>
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
            <StackPanel><Label Content="目标语言" Target="{Binding ElementName=TermLanguage}" Foreground="{StaticResource Secondary}" Padding="0,0,0,8"/><ComboBox x:Name="TermLanguage" AutomationProperties.Name="术语目标语言"/></StackPanel>
            <StackPanel Grid.Column="2"><Label Content="适用领域" Target="{Binding ElementName=TermDomain}" Foreground="{StaticResource Secondary}" Padding="0,0,0,8"/><ComboBox x:Name="TermDomain" AutomationProperties.Name="术语适用领域"/></StackPanel>
            <Button x:Name="AddTermButton" Grid.Column="4" Content="添加" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Height="38"/>
          </Grid>
        </StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="12,8,12,14"><TextBlock Text="术语列表" FontWeight="SemiBold"/><TextBlock x:Name="TermsCount" Text="共 0 条" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
          <DataGrid x:Name="TermsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Divider}" BorderThickness="0" RowHeight="44" ColumnHeaderHeight="40" Background="White" RowBackground="White" AlternatingRowBackground="{StaticResource SurfaceSoft}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="专业术语列表">
            <DataGrid.Columns><DataGridTextColumn Header="原文术语" Binding="{Binding Source}" Width="*" MinWidth="120"/><DataGridTextColumn Header="指定译法" Binding="{Binding Target}" Width="*" MinWidth="120"/><DataGridTextColumn Header="目标语言" Binding="{Binding Language}" Width="120"/><DataGridTextColumn Header="适用领域" Binding="{Binding Domain}" Width="170"/></DataGrid.Columns>
          </DataGrid>
        </Grid></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Button x:Name="SeedTermsButton" Content="加入电子工程示例术语" HorizontalAlignment="Left"/><Button x:Name="DeleteTermButton" Content="删除选中术语" HorizontalAlignment="Right"/></Grid>
      </Grid>

      <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="HistoryNote" Text="默认仅保留本次会话的记录。可在 API 设置中开启本地历史保存。" Foreground="{StaticResource Secondary}" Margin="0,0,0,16" TextWrapping="Wrap" LineHeight="21"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"><Grid>
          <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="翻译历史记录">
            <ListBox.ItemTemplate><DataTemplate><Border Padding="16" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Ink}" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" FontSize="14"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="HistoryEmpty" Text="还没有翻译记录&#10;&#10;完成翻译后，可以在这里找回原文和译文。" TextAlignment="Center" Foreground="{StaticResource Secondary}" FontSize="14" LineHeight="23" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Button x:Name="ClearHistoryButton" Content="清空历史" HorizontalAlignment="Left"/><Button x:Name="RestoreHistoryButton" Content="打开选中记录" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid>
      </Grid>

      <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="连接 DeepSeek" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="文本会直接发送至 DeepSeek 官方 API，按你的账户用量计费。" Foreground="{StaticResource Secondary}" Margin="0,9,0,24" TextWrapping="Wrap" LineHeight="21"/>
              <Label Content="API Key" Target="{Binding ElementName=ApiKeyInput}" FontWeight="SemiBold" Padding="0,0,0,9"/>
              <PasswordBox x:Name="ApiKeyInput" FontSize="15" AutomationProperties.Name="DeepSeek API Key"/>
              <CheckBox x:Name="RememberKey" Margin="0,10,0,24"><TextBlock Text="在这台电脑上保存密钥（Windows 当前用户加密）" TextWrapping="Wrap" LineHeight="21"/></CheckBox>
              <Label Content="模型名称" Target="{Binding ElementName=ModelBox}" FontWeight="SemiBold" Padding="0,0,0,9"/>
              <ComboBox x:Name="ModelBox" IsEditable="True" AutomationProperties.Name="DeepSeek 模型名称"/>
              <TextBlock Text="默认使用 deepseek-flash；也可以填写官方支持的其他模型名称。" Foreground="{StaticResource Secondary}" Margin="0,9,0,20" TextWrapping="Wrap" LineHeight="21"/>
              <TextBlock Text="官方接口：https://api.deepseek.com" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="GetKeyButton" Content="打开官方 API 平台" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,8">
              <TextBlock Text="本地数据" FontSize="18" FontWeight="SemiBold"/>
              <CheckBox x:Name="SaveHistoryCheck" Margin="0,18,0,10"><TextBlock Text="保存翻译历史，下次启动时继续查看（最多 50 条）" TextWrapping="Wrap" LineHeight="21"/></CheckBox>
              <TextBlock Text="历史包含原文和译文，以明文存放在当前用户目录。关闭保存并点击「保存设置」将删除磁盘历史。" TextWrapping="Wrap" Foreground="{StaticResource Secondary}" LineHeight="21"/>
              <TextBlock x:Name="DataPath" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" LineHeight="20" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,24,0,0"><TextBlock Text="使用提示：专业术语表可以提高一致性，但模型仍可能误译。论文关键术语、数值和正式用途文本建议人工复核。" TextWrapping="Wrap" Foreground="{StaticResource Secondary}" LineHeight="21"/></Border>
            </StackPanel>
          </Grid>
        </ScrollViewer></Border>
        <Grid Grid.Row="1" Margin="0,16,0,0"><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Right" Width="140" Height="44"/></Grid>
      </Grid>

      <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Ellipse Width="6" Height="6" Fill="{Binding Foreground, ElementName=StatusText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪 · 请先在 API 设置中填写密钥" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" LineHeight="20" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Grid.Column="2" Text="Ctrl + Enter 翻译   ·   F1 设置" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
