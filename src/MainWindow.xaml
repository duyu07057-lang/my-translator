<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="译知 · DeepSeek 桌面翻译" Width="1280" Height="840" MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#F4F7F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Foreground="#213C42" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#16796D"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#35575D"/>
      <Setter Property="BorderBrush" Value="#DCE6E7"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#16796D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C1D4D5"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="16,13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#DCE6E7"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#8ECBBE"/>
      <Setter Property="Foreground" Value="#264148"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#264148"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#DCE6E7"/><Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#35575D"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="10,7"><TextBlock Text="⌄" Foreground="#789493" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="SelectedContent" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,5,28,5" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="7,4,28,4" Padding="3" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="310" Background="White" BorderBrush="#DCE6E7" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,3,0,0">
              <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#16796D"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,9"/><Setter Property="Foreground" Value="#35575D"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E8F3EE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#16796D"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F3F8F6"/><Setter Property="Foreground" Value="#6F888B"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5F2EB"/><Setter Property="Foreground" Value="#16796D"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#7A8F94"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E8EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
  </Window.Resources>
  <Grid Background="#F4F7F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#173237">
      <Grid Margin="16,30,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,34">
          <Border Width="38" Height="38" Background="#9EDDC9" CornerRadius="10"><TextBlock Text="译" FontSize="22" FontWeight="Bold" Foreground="#173237" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="11,0,0,0"><TextBlock Text="译知" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="MY TRANSLATOR" FontSize="9" Foreground="#8FB4B4" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工作空间" FontSize="11" Foreground="#83A3A6" Margin="16,0,0,10"/>
          <Button x:Name="TranslateNav" Style="{StaticResource Nav}" Content="文 本 翻 译" Background="#2A4B50" Foreground="White"/>
          <Button x:Name="DocumentNav" Style="{StaticResource Nav}" Content="文 档 翻 译"/>
          <Button x:Name="GlossaryNav" Style="{StaticResource Nav}" Content="专 业 术 语"/>
          <Button x:Name="HistoryNav" Style="{StaticResource Nav}" Content="翻 译 历 史"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border Background="#214146" CornerRadius="10" Padding="13" Margin="0,0,0,17">
            <StackPanel><TextBlock Text="为专业表达而设计" Foreground="#C8E4DB" FontSize="12"/><TextBlock Text="论文 · 技术 · 日常文本" Foreground="#91B3B4" FontSize="10" Margin="0,7,0,0"/></StackPanel>
          </Border>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="API 设 置"/>
          <TextBlock Text="v1.1  /  Powered by DeepSeek" Foreground="#779A9C" FontSize="9" HorizontalAlignment="Center" Margin="0,17,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,25,32,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <StackPanel>
          <TextBlock x:Name="Breadcrumb" Text="工作空间  /  文本翻译" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <TextBlock x:Name="PageTitle" Text="文本翻译" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="自动识别语种，让每一个专业表达准确传达。" Foreground="#748D92" Margin="0,8,0,0"/>
        </StackPanel>
        <Button x:Name="ApiBadge" Content="●  待配置 API" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#16796D" Background="#E8F2ED" BorderThickness="0" Padding="13,8"/>
      </Grid>

      <Grid x:Name="TranslatePage" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="DocumentPanel" Grid.Row="0" Style="{StaticResource Card}" Padding="17,14" Margin="0,0,0,14" Visibility="Collapsed" AllowDrop="True">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock x:Name="DocumentFileName" Text="选择或拖入一份文档" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DocumentSummary" Text="PDF · Word (.docx) · Markdown · TXT" Foreground="#748D92" FontSize="11" Margin="0,7,0,0"/>
              </StackPanel>
              <Button x:Name="SelectDocumentButton" Grid.Column="1" Content="选择文档" Style="{StaticResource Primary}" VerticalAlignment="Center" Padding="17,10"/>
            </Grid>
            <TextBlock x:Name="DocumentWarning" Text="先在本地提取文字，预览确认后点击翻译。扫描 PDF 请先 OCR；不还原原文档版式。" Foreground="#8A7957" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="17,13" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="专业领域" VerticalAlignment="Center" Margin="0,0,13,0" Foreground="#657F84"/>
            <ComboBox x:Name="DomainBox" Grid.Column="1"/>
            <TextBlock Text="翻译风格" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,13,0" Foreground="#657F84"/>
            <ComboBox x:Name="StyleBox" Grid.Column="4"/>
            <Button x:Name="TermsHint" Grid.Column="5" Content="管理术语 →" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#16796D"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border BorderBrush="#E7EDEF" BorderThickness="0,0,0,1" Padding="16,13">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="SourceBox" Width="150"/>
                  <TextBlock x:Name="DetectedText" Grid.Column="1" Text="翻译时识别" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                </Grid>
              </Border>
              <Grid Grid.Row="1" Margin="7,8">
                <TextBox x:Name="SourceText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" VerticalContentAlignment="Top" BorderThickness="0" Padding="14" MaxLength="100000"/>
                <TextBlock x:Name="SourcePlaceholder" Text="输入或粘贴需要翻译的文本…&#10;&#10;支持论文段落、技术文档和日常表达。" FontSize="15" Foreground="#9AABAF" Margin="15,16" IsHitTestVisible="False" TextWrapping="Wrap" LineHeight="26"/>
              </Grid>
              <Border Grid.Row="2" BorderBrush="#EDF1F2" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid><StackPanel Orientation="Horizontal"><Button x:Name="PasteButton" Content="粘贴" Padding="11,6"/><Button x:Name="ImportButton" Content="导入文档" Padding="11,6" Margin="7,0,0,0"/><Button x:Name="ClearButton" Content="清空" Padding="10,6" Margin="7,0,0,0" BorderThickness="0"/></StackPanel><TextBlock x:Name="SourceCount" Text="0 字符" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Background="#FCFEFD">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border BorderBrush="#E7EDEF" BorderThickness="0,0,0,1" Padding="16,13">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="TargetBox" Width="150"/><TextBlock x:Name="OutputState" Grid.Column="1" Text="译文" Foreground="#789493" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0"/><Button x:Name="SwapButton" Grid.Column="2" Content="⇄  交换" Padding="10,6" BorderThickness="0" Background="Transparent" ToolTip="将译文放回原文，并交换语言"/></Grid>
              </Border>
              <Grid Grid.Row="1" Margin="7,8">
                <TextBox x:Name="OutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" Padding="14"/>
                <StackPanel x:Name="OutputPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Border Width="58" Height="58" Background="#EAF4EF" CornerRadius="18" HorizontalAlignment="Center"><TextBlock Text="文" Foreground="#7FAE9F" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock Text="译文将在这里呈现" Foreground="#93A8A5" Margin="0,17,0,7" HorizontalAlignment="Center"/>
                  <TextBlock Text="保留原意，也照顾专业语境" FontSize="11" Foreground="#A0B1AE" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <Border Grid.Row="2" BorderBrush="#EDF1F2" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid><StackPanel Orientation="Horizontal"><Button x:Name="CopyButton" Content="复制译文" Padding="11,6"/><Button x:Name="ExportButton" Content="导出" Padding="11,6" Margin="7,0,0,0"/></StackPanel><TextBlock x:Name="OutputCount" Text="0 字符" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <StackPanel x:Name="TextExamples" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="试一试" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="ExampleButton" Content="电子工程示例" Padding="11,7" Background="#EBF1F2" BorderThickness="0"/></StackPanel>
            <TextBlock x:Name="DocumentTip" Text="本地提取 · 预览原文 · 选择目标语言后翻译" Foreground="#748D92" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="停止翻译" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="TranslateButton" Style="{StaticResource Primary}" Content="开始翻译    ↵" Width="164" Height="44" ToolTip="Ctrl + Enter"/></StackPanel>
          </Grid>
          <ProgressBar x:Name="TaskProgress" Grid.Row="1" Height="3" Margin="0,12,0,0" Foreground="#16796D" Background="#E5EDEE" Visibility="Collapsed"/>
        </Grid>
      </Grid>

      <Grid x:Name="GlossaryPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="让术语保持一致" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="指定术语的译法。只有匹配原文、目标语言和领域的条目才会随翻译发送。" Foreground="#748D92" Margin="0,8,0,17" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="136"/><ColumnDefinition Width="178"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="原文术语" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="TermSource" MaxLength="200"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="指定译法" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="TermTarget" MaxLength="200"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="目标语言" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="TermLanguage"/></StackPanel>
              <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="适用领域" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="TermDomain"/></StackPanel>
              <Button x:Name="AddTermButton" Grid.Column="4" Content="添加" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Height="39"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
          <DataGrid x:Name="TermsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F2" BorderThickness="0" RowHeight="44" ColumnHeaderHeight="40" Background="White" RowBackground="White" AlternatingRowBackground="#F8FBFA">
            <DataGrid.Columns><DataGridTextColumn Header="原文术语" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="指定译法" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="目标语言" Binding="{Binding Language}" Width="130"/><DataGridTextColumn Header="适用领域" Binding="{Binding Domain}" Width="170"/></DataGrid.Columns>
          </DataGrid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Button x:Name="SeedTermsButton" Content="加入电子工程示例术语" HorizontalAlignment="Left"/><Button x:Name="DeleteTermButton" Content="删除选中术语" HorizontalAlignment="Right"/></Grid>
      </Grid>

      <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="HistoryNote" Text="默认仅保留本次会话的记录。可在 API 设置中开启本地历史保存。" Foreground="#748D92" Margin="0,0,0,16" TextWrapping="Wrap"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
          <Grid>
            <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><Border Padding="12,13" BorderBrush="#E7EDEF" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#16796D" FontSize="11"/><TextBlock Text="{Binding Summary}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" FontSize="14"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="HistoryEmpty" Text="还没有翻译记录&#10;&#10;完成翻译后，可以在这里找回原文和译文。" TextAlignment="Center" Foreground="#93A8A5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Button x:Name="ClearHistoryButton" Content="清空历史" HorizontalAlignment="Left"/><Button x:Name="RestoreHistoryButton" Content="打开选中记录" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid>
      </Grid>

      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
          <Border Style="{StaticResource Card}" Padding="25">
            <StackPanel>
              <TextBlock Text="连接 DeepSeek" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="文本会直接发送至 DeepSeek 官方 API，按你的账户用量计费。" Foreground="#748D92" Margin="0,9,0,22" TextWrapping="Wrap"/>
              <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <PasswordBox x:Name="ApiKeyInput" Padding="12" FontSize="15" BorderBrush="#DCE6E7"/>
              <CheckBox x:Name="RememberKey" Content="在这台电脑上保存密钥（Windows 当前用户加密）" Margin="0,13,0,22"/>
              <TextBlock Text="模型名称" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <ComboBox x:Name="ModelBox" IsEditable="True"/>
              <TextBlock Text="默认使用 deepseek-flash；也可以填写官方支持的其他模型名称。" Style="{StaticResource Muted}" Margin="0,9,0,20" TextWrapping="Wrap"/>
              <TextBlock Text="官方接口：https://api.deepseek.com" Foreground="#748D92"/>
              <Grid Margin="0,23,0,0"><Button x:Name="GetKeyButton" Content="打开官方 API 平台 ↗" HorizontalAlignment="Left"/><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Right" Width="130"/></Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="25" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="本地数据" FontSize="17" FontWeight="SemiBold"/>
              <CheckBox x:Name="SaveHistoryCheck" Content="保存翻译历史，下次启动时继续查看（最多 50 条）" Margin="0,18,0,10"/>
              <TextBlock Text="历史包含原文和译文，以明文存放在当前用户目录。关闭保存并点击「保存设置」将删除磁盘历史。" TextWrapping="Wrap" Foreground="#748D92" FontSize="12"/>
              <TextBlock x:Name="DataPath" Margin="0,13,0,0" FontSize="11" Foreground="#8B9DA1" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="使用提示：专业术语表可以提高一致性，但模型仍可能误译。论文关键术语、数值和正式用途文本建议人工复核。" TextWrapping="Wrap" Foreground="#748D92" FontSize="12" Margin="3,19,3,0"/>
        </StackPanel>
      </ScrollViewer>

